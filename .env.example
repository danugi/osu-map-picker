# OAuth application: https://osu.ppy.sh/home/account/edit#new-oauth-application
# Create an application, leave the callback URL empty (client credentials only).
# Copy this file to .env and fill in the real values. Never commit .env.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Optional settings (defaults shown)
# OSU_PICKER_DATA_DIR=data
# OSU_PICKER_DB=data/osu_picker.db
# OSU_PICKER_PORTABLE=1  # enable the first-run API screen in a source checkout
# OSU_PICKER_HOSTED=1    # never ask visitors for personal credentials
# OSU_REQUEST_TIMEOUT=20
# OSU_MIN_INTERVAL_SECONDS=1.1
# OSU_MAX_RETRIES=2
# OSU_CACHE_TTL_MINUTES=30
